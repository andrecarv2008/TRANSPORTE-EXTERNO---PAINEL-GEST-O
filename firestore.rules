rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedEmail() && request.auth.token.email == "andreandersoncarvalhorocha1@gmail.com";
    }

    // For voyages (viagens)
    match /viagens/{viagemId} {
      // Allow public read-only access so anyone visiting the page sees the dashboard
      allow read: if true;
      
      // Allow writes ONLY if the user is a bootstrap administrator
      allow write: if isAdmin();
    }

    // For metadata
    match /metadata/{metadataId} {
      // Allow public read-only access to see when the dashboard was last updated
      allow read: if true;
      
      // Allow writes ONLY if the user is a bootstrap administrator
      allow write: if isAdmin();
    }
  }
}
