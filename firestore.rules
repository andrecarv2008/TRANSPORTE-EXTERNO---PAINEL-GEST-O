rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.email == "andreandersoncarvalho@gmail.com" || 
        request.auth.token.email == "andreandersoncarvalhorocha1@gmail.com"
      );
    }

    // For voyages (viagens)
    match /viagens/{viagemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // For metadata
    match /metadata/{metadataId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // For import logs history (logs)
    match /import_logs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
