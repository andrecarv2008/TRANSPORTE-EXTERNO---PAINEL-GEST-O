rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedEmail() && request.auth.token.email == "andreandersoncarvalhorocha1@gmail.com";
    }

    // For voyages (viagens)
    match /viagens/{viagemId} {
      // Allow read and write access for both auto-hydration and playtesting spreadsheet uploads/resets
      allow read, write: if true;
    }

    // For metadata
    match /metadata/{metadataId} {
      // Allow read and write access to update the last upload metadata
      allow read, write: if true;
    }

    // For import logs history (logs)
    match /import_logs/{logId} {
      // Allow read and write access for storing Excel import history logs
      allow read, write: if true;
    }
  }
}
